#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
signing_identity="${CAPS_TAP_SIGNING_IDENTITY:-Caps Tap Local}"
if ! security find-identity -v -p codesigning | grep -Fq "\"$signing_identity\""; then
  printf 'No valid code-signing identity named %s; create/trust it in Keychain Access.\n' "$signing_identity" >&2
  exit 1
fi
cargo build --release
app="dist/Caps Tap.app"
mkdir -p "$app/Contents/MacOS"
cp target/release/caps-tap "$app/Contents/MacOS/caps-tap"
cat > "$app/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleIdentifier</key><string>dev.andreasdeleuran.capstap</string>
  <key>CFBundleName</key><string>Caps Tap</string>
  <key>CFBundleDisplayName</key><string>Caps Tap</string>
  <key>CFBundleExecutable</key><string>caps-tap</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>CFBundleShortVersionString</key><string>0.1.0</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>LSUIElement</key><true/>
</dict></plist>
PLIST
codesign --force --sign "$signing_identity" --identifier dev.andreasdeleuran.capstap "$app"
codesign --verify --deep --strict "$app"
printf 'Built and signed %s with %s\n' "$app" "$signing_identity"
